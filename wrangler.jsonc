{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hometech-fun-21-switch-game",
  "compatibility_date": "2026-08-25",
  "routes": [
    {
      "pattern": "www.hometech.fm/fun/21-switch-game",
      "zone_name": "hometech.fm"
    },
    {
      "pattern": "www.hometech.fm/fun/21-switch-game/*",
      "zone_name": "hometech.fm"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
